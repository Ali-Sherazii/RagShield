# Copy to .env and adjust as needed. Every value here has a working default
# in ragshield/config.py -- only set what you want to override.

# --- storage ---
# CHROMA_DIR=data/chroma
# COLLECTION=ragshield

# --- embeddings ---
# EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- chunking ---
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120

# --- retrieval ---
# TOP_K=4

# --- generation ---
# LLM_MODEL=llama3.1:8b
# LLM_TEMPERATURE=0
# OLLAMA_HOST=http://localhost:11434

# --- evaluation ---
# RUNS_PER_CASE=3
